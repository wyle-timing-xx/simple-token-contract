# ========================================
# 重要提示：这是示例文件，请复制为 .env 并填入真实值
# 复制命令：cp .env.example .env
# ========================================

# 私钥配置（必需 - 用于部署合约）
# 从MetaMask导出私钥，注意：不要泄露给任何人！
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Sepolia测试网RPC URL（必需）
# 免费获取方式：
# 1. Infura: https://infura.io/ 注册后创建项目
# 2. Alchemy: https://alchemy.com/ 注册后创建应用
# 3. QuickNode: https://quicknode.com/ 
SEPOLIA_URL=https://sepolia.infura.io/v3/your_infura_project_id

# 或者使用Alchemy
# SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key

# 或者使用免费的公共RPC（不稳定，仅测试用）
# SEPOLIA_URL=https://rpc.sepolia.org

# 主网配置（可选）
MAINNET_URL=https://mainnet.infura.io/v3/your_infura_project_id

# Etherscan API Key（可选 - 用于合约验证）
# 在 https://etherscan.io/apis 免费获取
ETHERSCAN_API_KEY=your_etherscan_api_key

# Infura项目ID（如果使用Infura）
INFURA_PROJECT_ID=your_infura_project_id

# Gas报告（可选）
REPORT_GAS=true